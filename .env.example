# Production canonical domain. Cloudflare preview URLs are never used as canonicals.
SITE_URL=https://realmstudios.pt
ASTRO_TELEMETRY_DISABLED=1

# Browser-safe Supabase project URL and publishable (or legacy anon) key.
# Never put a service-role/secret key in a PUBLIC_ variable.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
