    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "axe-core": "^4.14.0",
