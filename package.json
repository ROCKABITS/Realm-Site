    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "pagefind": "1.5.2",
    "typescript": "^5.9.0"
  }
}
