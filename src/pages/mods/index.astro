---
import Layout from '../../layouts/Layout.astro';
import ModCard from '../../components/ModCard.astro';
import Icon from '../../components/Icon.astro';
import { mods } from '../../data/mods';
import { categories } from '../../data/site';
---
<Layout title="The mod collection" description="Explore 13 Minecraft mods by ROCKadm for NeoForge 1.21.1. Discover roleplay, markets, elections, justice, and more.">
  <section class="container page-intro" data-pagefind-body><p class="eyebrow">MADE FOR YOUR WORLD</p><h1>The mod <em>collection.</em></h1><p>Give your players more ways to live, trade, lead, and belong.<br class="desktop-break" /> Explore the collection and find your next addition.</p><div class="intro-meta"><span class="status-dot" /> 13 mods <span>·</span> Minecraft 1.21.1 <span>·</span> NeoForge</div></section>
  <section class="container collection-section" aria-label="Mod collection"><div class="collection-controls"><div class="filter-tabs" role="group" aria-label="Filter mods by category">{categories.map((category, index) => <button type="button" class:list={['filter-tab', { selected: index === 0 }]} data-filter={category} aria-pressed={index === 0}>{category}</button>)}</div><label class="collection-search"><Icon name="search" size={17} /><span class="sr-only">Search mods</span><input type="search" id="mod-filter" placeholder="Find a mod…" /></label></div><p id="mod-count" class="results-count" role="status">Showing all 13 mods</p><div class="mod-grid">{mods.map((mod, index) => <ModCard mod={mod} index={index} />)}</div><div class="empty-state" id="no-mods" hidden><Icon name="search" size={32} /><h2>No mods found.</h2><p>Try a different name or category.</p><button class="button button-outline" id="reset-mods">Show all mods</button></div><aside class="notice"><Icon name="book" size={24} /><div><strong>Putting your collection together?</strong><p>Check the installation guide for required dependencies, client/server setup, and mods that replace older versions.</p></div><a href="/wiki/installation/" class="text-link">Read the guide <Icon name="arrow" size={18} /></a></aside></section>
  <script>
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('.mod-card')];
    const input = document.querySelector<HTMLInputElement>('#mod-filter')!;
    const count = document.querySelector<HTMLElement>('#mod-count')!;
    const empty = document.querySelector<HTMLElement>('#no-mods')!;
    let category = 'All mods';
    const filter = () => { const query = input.value.trim().toLowerCase(); let visible = 0; for (const card of cards) { card.hidden = !((category === 'All mods' || card.dataset.category === category) && card.dataset.modName!.includes(query)); if (!card.hidden) visible++; } count.textContent = visible === cards.length ? `Showing all ${visible} mods` : `Showing ${visible} of ${cards.length} mods`; empty.hidden = visible > 0; for (const button of buttons) { const selected = button.dataset.filter === category; button.classList.toggle('selected', selected); button.setAttribute('aria-pressed', String(selected)); } };
    buttons.forEach(button => button.addEventListener('click', () => { category = button.dataset.filter!; filter(); }));
    input.addEventListener('input', filter);
    document.querySelector('#reset-mods')?.addEventListener('click', () => { category = 'All mods'; input.value = ''; filter(); input.focus(); });
  </script>
</Layout>
