---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
const releases = (await getCollection('changelog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Season 8 changelog" description="Release notes for the Season 8 modpack by ROCKadm. Follow additions, changes, fixes, and important update instructions."><div class="container"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/modpack/">Season 8</a><Icon name="chevron" size={12} /><span>Changelog</span></nav></div><section class="container page-intro" data-pagefind-body><p class="eyebrow">THE SEASON 8 JOURNAL</p><h1>Every update.<br /><em>All in one place.</em></h1><p>Additions, changes, fixes, and the details worth knowing<br class="desktop-break" /> before your next adventure.</p></section><section class="container changelog-section" aria-label="Release notes">{releases.length ? <div class="release-list">{releases.map(release => <a class="release-card" href={`/modpack/changelog/${release.id}/`}><span class="release-version">{release.data.version}</span><div><span class="eyebrow">{release.data.date.toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' })}</span><h2>{release.data.title}</h2><p>{release.data.summary}</p></div><Icon name="arrow" /></a>)}</div> : <div class="empty-state release-empty"><Icon name="scroll" size={38} /><p class="eyebrow">A FRESH PAGE</p><h2>No release notes yet.</h2><p>When ROCKadm publishes the first modpack changelog,<br class="desktop-break" /> you’ll find it here.</p><a href="/modpack/" class="button button-outline">Back to Season 8 <Icon name="arrow" size={17} /></a></div>}</section></Layout>
