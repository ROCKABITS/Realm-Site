---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { modpack } from '../../data/site';
const releases = (await getCollection('changelog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Season 8 modpack" description="The home of Season 8, the modpack by ROCKadm. Follow its release notes, find player guides, and discover the next chapter.">
  <section class="container modpack-hero" data-pagefind-body><div><a href="/" class="eyebrow">REALM STUDIOS / THE MODPACK</a><h1>One world.<br />A thousand stories.<br /><em>Season 8.</em></h1><p>A home for the modpack by ROCKadm.<br />Follow the updates, find your way around,<br class="desktop-break" /> and be part of the next chapter.</p><div class="button-row">{modpack.downloadUrl ? <a href={modpack.downloadUrl} class="button button-gold" target="_blank" rel="noopener noreferrer"><Icon name="download" size={18} /> Get the modpack</a> : <a href="/modpack/changelog/" class="button button-gold"><Icon name="scroll" size={18} /> Follow the updates</a>}<a href="/wiki/" class="button button-quiet">Explore the wiki <Icon name="arrow" size={18} /></a></div>{modpack.version && <span class="version-label">Current modpack version · {modpack.version}</span>}</div><div class="season-large-art" aria-hidden="true"><div class="season-ring"></div><div class="season-ring ring-two"></div><span class="season-top">THE NEXT CHAPTER</span><span class="season-crown">♔</span><span class="season-roman">VIII</span><span class="season-bottom">A WORLD WE BUILD TOGETHER</span><span class="season-star">✦</span></div></section>
  <div class="container modpack-divider"><span>THE SEASON 8 JOURNAL</span><span class="tiny-diamond">◆</span><span>EVERY UPDATE HAS A STORY</span></div>
  <section class="container section"><div class="section-heading"><div><p class="eyebrow">FROM THE JOURNAL</p><h2>What’s <em>new.</em></h2></div><a href="/modpack/changelog/" class="text-link">All release notes <Icon name="arrow" size={18} /></a></div>{releases.length ? <div class="release-list">{releases.slice(0, 3).map(release => <a class="release-card" href={`/modpack/changelog/${release.id}/`}><span class="release-version">{release.data.version}</span><div><span class="eyebrow">{release.data.date.toLocaleDateString('en-GB', { dateStyle: 'long', timeZone: 'UTC' })}</span><h3>{release.data.title}</h3><p>{release.data.summary}</p></div><Icon name="arrow" /></a>)}</div> : <div class="journal-empty"><div class="journal-seal"><Icon name="scroll" size={32} /></div><div><span class="eyebrow">THE FIRST PAGE IS STILL TO COME</span><h3>A place for every chapter.</h3><p>No release notes have been published yet. Future modpack updates will appear here, with a full changelog for each release.</p></div></div>}</section>
  <section class="container modpack-links"><a href="/mods/"><Icon name="spark" size={28} /><h3>Discover the mods</h3><p>Explore ROCKadm’s individual creations.</p><span class="text-link">Browse the collection <Icon name="arrow" size={16} /></span></a><a href="/wiki/"><Icon name="book" size={28} /><h3>Find your footing</h3><p>Learn how each Realm system works.</p><span class="text-link">Visit the player wiki <Icon name="arrow" size={16} /></span></a></section>
</Layout>
