---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
const guides = (await getCollection('wiki')).sort((a, b) => a.data.order - b.data.order);
const groups = ['Getting started', 'Character & society', 'Economy & trade', 'Kingdom & justice', 'Activities & rewards'];
---
<Layout title="Player wiki" description="Learn how to install and use Realm Studios mods. Step-by-step Minecraft guides for characters, shops, elections, marriage, and kingdom life." light>
  <section class="wiki-intro"><div class="container"><p class="eyebrow">KNOWLEDGE FOR THE JOURNEY</p><h1>The player’s <em>companion.</em></h1><p>A clear path from “where do I start?” to “I’ve got this.”<br class="desktop-break" /> Find a guide, learn a system, and make it part of your story.</p><label class="wiki-search"><Icon name="search" /><span class="sr-only">Filter player guides</span><input id="wiki-filter" type="search" placeholder="Find a guide — characters, markets, elections…" /><span>{guides.length} GUIDES</span></label></div></section>
  <div class="container wiki-index"><aside class="wiki-category-nav"><span class="eyebrow">BROWSE THE ARCHIVE</span><nav aria-label="Guide categories">{groups.map((group, index) => <a href={`#category-${index}`}><span>{String(index + 1).padStart(2, '0')}</span>{group}<Icon name="chevron" size={13} /></a>)}</nav><div class="wiki-help"><Icon name="spark" size={23} /><h3>New around here?</h3><p>Start with installation, then create your first character.</p><a href="/wiki/installation/" class="text-link">Start here <Icon name="arrow" size={16} /></a></div></aside><div class="wiki-groups"><p class="sr-only" id="wiki-count" role="status">{guides.length} guides available</p>{groups.map((group, index) => <section id={`category-${index}`} class="wiki-group"><div class="wiki-group-heading"><span class="eyebrow">CHAPTER {String(index + 1).padStart(2, '0')}</span><h2>{group}</h2></div><div class="wiki-guide-grid">{guides.filter(guide => guide.data.category === group).map(guide => <a href={`/wiki/${guide.id}/`} class="wiki-guide-card" data-guide-search={`${guide.data.title} ${guide.data.description} ${guide.data.category}`.toLowerCase()}><Icon name="book" size={22} /><h3>{guide.data.title}</h3><p>{guide.data.description}</p><span>Read the guide <Icon name="arrow" size={16} /></span></a>)}</div></section>)}<div class="empty-state" id="no-guides" hidden><h2>No guides found.</h2><p>Try another keyword, or use the site search for the full text.</p><button class="button button-dark" data-search-open>Search the full archive <Icon name="search" size={17} /></button></div></div></div>
  <script>
    const input = document.querySelector<HTMLInputElement>('#wiki-filter')!;
    input.addEventListener('input', () => { let visible = 0; const query = input.value.trim().toLowerCase(); document.querySelectorAll<HTMLElement>('[data-guide-search]').forEach(card => { card.hidden = !card.dataset.guideSearch!.includes(query); if (!card.hidden) visible++; }); document.querySelectorAll<HTMLElement>('.wiki-group').forEach(group => { group.hidden = !group.querySelector('[data-guide-search]:not([hidden])'); }); document.querySelector<HTMLElement>('#no-guides')!.hidden = visible > 0; document.querySelector<HTMLElement>('#wiki-count')!.textContent = `${visible} guides found`; });
  </script>
</Layout>
