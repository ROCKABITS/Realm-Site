---
import Layout from '../layouts/Layout.astro';
import Artwork from '../components/Artwork.astro';
import ModCard from '../components/ModCard.astro';
import Icon from '../components/Icon.astro';
import { mods } from '../data/mods';
---
<Layout title="Home">
  <section class="hero container" data-pagefind-body>
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot" /> INDEPENDENT MINECRAFT MODS</p><h1>Every kingdom<br />starts with <em>you.</em></h1><p class="hero-description">A name. A trade. A seat at the council.<br class="desktop-break" /> Bring your world to life with mods that give<br class="desktop-break" /> every player a part in the story.</p><div class="button-row"><a href="/mods/" class="button button-gold">Discover the mods <Icon name="arrow" size={18} /></a><a href="/wiki/" class="button button-quiet"><Icon name="book" size={18} /> Open the wiki</a></div><div class="hero-byline"><span class="mini-seal">R</span><span>Created with care by <strong>ROCKadm</strong><small>For the worlds we build together.</small></span></div></div>
    <div class="hero-art" aria-label="Artwork from Realm Origins, Realm Treasury, and Realm Markets"><div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div><span class="orbit-star star-one">✦</span><span class="orbit-star star-two">✧</span><span class="art-caption caption-top">A WORLD OF POSSIBILITIES</span><div class="hero-piece piece-treasury"><Artwork name="treasury" alt="Realm Treasury's royal chest and ledger" eager /></div><div class="hero-piece piece-origins"><Artwork name="origins" alt="Realm Origins' illustrated character book" eager /></div><div class="hero-piece piece-markets"><Artwork name="markets" alt="Realm Markets' medieval trading stall" eager /></div><div class="hero-art-note"><span class="status-dot" /><span><strong>13 mods.</strong> One connected world.</span></div><span class="art-caption caption-bottom">YOUR NEXT CHAPTER IS YOURS TO WRITE</span></div>
  </section>
  <div class="compatibility-strip"><div class="container"><span><span class="tiny-diamond">◆</span> MADE FOR MINECRAFT JAVA</span><span>Minecraft <strong>1.21.1</strong></span><span>NeoForge <strong>21.1.256+</strong></span><span>Java <strong>21</strong></span><a href="/wiki/installation/">Installation guide <Icon name="diagonal" size={14} /></a></div></div>
  <section class="section container" aria-labelledby="collection-title"><div class="section-heading" data-reveal><div><p class="eyebrow">THE COLLECTION</p><h2 id="collection-title">Small details. <em>Bigger stories.</em></h2></div><a href="/mods/" class="text-link">Explore all 13 mods <Icon name="arrow" size={18} /></a></div><div class="mod-grid featured-grid">{mods.filter(mod => mod.featured).map((mod, index) => <ModCard mod={mod} index={index} />)}</div><div class="collection-footnote"><span class="tiny-diamond">◆</span><p>Made to work together. Choose the systems that fit your world.</p><a href="/wiki/installation/">Check dependencies <Icon name="diagonal" size={13} /></a></div></section>
  <section class="wiki-feature" aria-labelledby="wiki-title"><div class="container wiki-feature-inner"><div data-reveal><p class="eyebrow">THE PLAYER’S COMPANION</p><h2 id="wiki-title">A little guidance.<br /><em>A world to discover.</em></h2><p>From your first character to your first royal decree, find clear guides for the things you want to do.</p><a href="/wiki/" class="button button-dark">Step into the wiki <Icon name="book" size={18} /></a></div><div class="guide-preview-list"><a href="/wiki/installation/"><span class="guide-number">01</span><div><span class="eyebrow">START YOUR JOURNEY</span><h3>Make yourself at home.</h3><p>Install the mods and get your world ready.</p></div><Icon name="diagonal" /></a><a href="/wiki/realm-origins/"><span class="guide-number">02</span><div><span class="eyebrow">BECOME SOMEONE</span><h3>Write your first chapter.</h3><p>Create a character and discover your book.</p></div><Icon name="diagonal" /></a><a href="/wiki/realm-markets/"><span class="guide-number">03</span><div><span class="eyebrow">FIND YOUR PLACE</span><h3>Set up shop.</h3><p>Stock a stall and make your first sale.</p></div><Icon name="diagonal" /></a></div></div></section>
  <section class="section container"><a href="/modpack/" class="season-banner" data-reveal><div><p class="eyebrow"><span class="status-dot" /> THE MODPACK</p><h2>Season 8.<br /><em>Your next chapter.</em></h2><p>A dedicated home for the modpack, its updates,<br class="desktop-break" /> and the stories still to come.</p><span class="text-link">Explore Season 8 <Icon name="arrow" size={18} /></span></div><div class="season-emblem" aria-hidden="true"><span class="emblem-small">ROCKadm</span><span class="roman">VIII</span><span class="emblem-small">A WORLD WE SHARE</span></div><span class="banner-corner">✧</span></a></section>
</Layout>
