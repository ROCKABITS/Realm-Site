---
import Layout from '../layouts/Layout.astro';
import Artwork from '../components/Artwork.astro';
import ModCard from '../components/ModCard.astro';
import Icon from '../components/Icon.astro';
import { mods } from '../data/mods';
import home from '../data/home.json';
---
<Layout title="Home">
  <section class="hero container journey-entry" data-pagefind-body>
    <div class="hero-copy"><p class="eyebrow"><span class="status-dot" /> {home.eyebrow}</p><h1>{home.heroTitle}<br />{home.heroEmphasis}</h1><p class="hero-description">{home.heroDescription}</p><div class="button-row"><a href="/mods/" class="button button-gold">{home.heroPrimary} <Icon name="arrow" size={18} /></a><a href="/wiki/" class="button button-quiet"><Icon name="book" size={18} /> {home.heroSecondary}</a></div><div class="hero-byline"><span class="mini-seal">R</span><span>Created with care by <strong>ROCKadm</strong><small>For the worlds we build together.</small></span></div></div>
    <div class="hero-art" aria-label="Artwork from Realm Origins, Realm Treasury, and Realm Markets"><div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div><span class="orbit-star star-one">✦</span><span class="orbit-star star-two">✧</span><span class="art-caption caption-top">A WORLD OF POSSIBILITIES</span><div class="hero-piece piece-treasury"><Artwork name="treasury" alt="Realm Treasury's royal chest and ledger" eager /></div><div class="hero-piece piece-origins"><Artwork name="origins" alt="Realm Origins' illustrated character book" eager /></div><div class="hero-piece piece-markets"><Artwork name="markets" alt="Realm Markets' medieval trading stall" eager /></div><div class="hero-art-note"><span class="status-dot" /><span><strong>13 mods.</strong> One connected world.</span></div><span class="art-caption caption-bottom">YOUR NEXT CHAPTER IS YOURS TO WRITE</span></div>
    <a class="scroll-cue" href="#mods"><span>Scroll to explore</span><b aria-hidden="true">↓</b></a>
  </section>
  <div class="compatibility-strip"><div class="container"><span><span class="tiny-diamond">◆</span> MADE FOR MINECRAFT JAVA</span><span>Minecraft <strong>1.21.1</strong></span><span>NeoForge <strong>21.1.256+</strong></span><span>Java <strong>21</strong></span><a href="/wiki/installation/">Installation guide <Icon name="diagonal" size={14} /></a></div></div>
  <section class="realm-level realm-level-collection" id="mods" aria-labelledby="collection-title"><span class="level-marker" aria-hidden="true"><b>01</b><i>The collection</i></span><div class="container section"><div class="section-heading" data-reveal><div><p class="eyebrow">{home.collectionEyebrow}</p><h2 id="collection-title">{home.collectionTitle} <em>{home.collectionEmphasis}</em></h2></div><a href="/mods/" class="text-link">{home.collectionLink} <Icon name="arrow" size={18} /></a></div><div class="mod-grid featured-grid">{mods.filter(mod => mod.featured).map((mod, index) => <ModCard mod={mod} index={index} />)}</div><div class="collection-footnote"><span class="tiny-diamond">◆</span><p>Made to work together. Choose the systems that fit your world.</p><a href="/wiki/installation/">Check dependencies <Icon name="diagonal" size={13} /></a></div></div></section>
  <section class="wiki-feature realm-level realm-level-wiki" id="wiki" aria-labelledby="wiki-title"><span class="level-marker" aria-hidden="true"><b>02</b><i>The field guide</i></span><div class="container wiki-feature-inner"><div data-reveal><p class="eyebrow">{home.wikiEyebrow}</p><h2 id="wiki-title">{home.wikiTitle}<br /><em>{home.wikiEmphasis}</em></h2><p>{home.wikiDescription}</p><a href="/wiki/" class="button button-dark">Step into the wiki <Icon name="book" size={18} /></a></div><div class="guide-preview-list"><a href="/wiki/installation/"><span class="guide-number">01</span><div><span class="eyebrow">START YOUR JOURNEY</span><h3>Make yourself at home.</h3><p>Install the mods and get your world ready.</p></div><Icon name="diagonal" /></a><a href="/wiki/realm-origins/"><span class="guide-number">02</span><div><span class="eyebrow">BECOME SOMEONE</span><h3>Write your first chapter.</h3><p>Create a character and discover your book.</p></div><Icon name="diagonal" /></a><a href="/wiki/realm-markets/"><span class="guide-number">03</span><div><span class="eyebrow">FIND YOUR PLACE</span><h3>Set up shop.</h3><p>Stock a stall and make your first sale.</p></div><Icon name="diagonal" /></a></div></div></section>
  <section class="realm-level realm-level-season" id="season"><span class="level-marker" aria-hidden="true"><b>03</b><i>Season eight</i></span><div class="container section"><a href="/modpack/" class="season-banner" data-reveal><div><p class="eyebrow"><span class="status-dot" /> {home.seasonLabel}</p><h2>{home.seasonTitle}<br /><em>{home.seasonEmphasis}</em></h2><p>{home.seasonDescription}</p><span class="text-link">Explore Season 8 <Icon name="arrow" size={18} /></span></div><div class="season-emblem" aria-hidden="true"><Artwork name="season8Logo" alt="Season 8 modpack logo" class="season-emblem-logo" /></div><span class="banner-corner">✧</span></a></div></section>
</Layout>
